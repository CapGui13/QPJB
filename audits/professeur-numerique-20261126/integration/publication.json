  "deferred": [
    {
      "id": "SEF-V484-001",
      "reason": "Le Passe est plus instructif que 2SA seulement si le 2♦ Drury d'attente exige une poursuite selon l'accord complet ; ne pas imposer cette interprétation sans validation globale."
    },
    {
      "id": "SEF-V3-047-4",
      "reason": "L'intervention exceptionnelle sur belle majeure quatrième peut dépendre de l'accord et de la position. Ne pas fabriquer une seconde réponse défendable."
    }
  ],
  "holds": [
    {
      "id": "SEF-L33-005",
      "choice": "2♦",
      "reason": "Le visa #364 reconnaît explicitement l'approche offensive. Maintenir 1♥ dans le cadre annoncé, sans attribuer une erreur psychologique à 2♦.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "V2-M1-031",
      "choice": "1♦",
      "reason": "Le texte approuvé par #364 reconnaît 1♦ envisageable. Conserver 2♣ comme préférence de la fiche, et ne pas diagnostiquer 1♦.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "V2-M4-017",
      "choice": "Passe",
      "reason": "Le corrigé dit explicitement que l'intervention vulnérable contre non-vulnérable n'est pas obligatoire. Passe peut être une décision de prudence.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-L33-005",
      "choice": "4♥",
      "reason": "Le contexte ne fixe pas la vulnérabilité ni l'objectif de barrage ; le jugement avec huit Cœurs ne permet pas une attribution certaine.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V3-105-3",
      "choice": "2SA",
      "reason": "4♥ est qualifié de conclusion raisonnable, non imposée ; le relais peut explorer le jeu de l'ouvreur.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V44-048",
      "choice": "2SA",
      "reason": "Le corrigé réserve le relais à une décision incertaine ; le jugement de manche avec 11 H n'est pas un seuil mécanique.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-L14-013",
      "choice": "3♣",
      "reason": "Le Stayman n'est pas le Texas demandé, mais la réserve du lot A concerne la rectification après 2SA issu d'une ouverture forte. Ne pas transformer cette réserve de développement en nouvelle règle.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-L14-013",
      "choice": "3♦",
      "reason": "Le Texas Pique est 3♥ dans le contexte ; maintenir néanmoins la prudence de la fiche sur le développement après ouverture forte jusqu'à cohérence globale des suites à 2SA.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-L14-013",
      "choice": "3♠",
      "reason": "L'objectif est de faire déclarer Pique par l'ouvreur. Ne pas extrapoler une règle de rectification ou de sens de 3♠ au-delà du contexte.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V44-005",
      "choice": "2♣",
      "reason": "#364 a confirmé 2SA naturel 11–12 H et les tenues non obligatoires. La préférence pour 2SA est validée ; ne pas inventer une interdiction générale du soutien à quatre Trèfles.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V49-006",
      "choice": "1♥",
      "reason": "#364 confirme la priorité majeure jusqu'à 12 HL inclus ; cette main a 15 HL. Le corrigé est soldé, mais la revue B n'a pas fourni d'hypothèse signée pour cette option : la prudence diagnostique est maintenue.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V49-006",
      "choice": "2♦",
      "reason": "#364 confirme l'ordre des couleurs à 15 HL ; le sens précis du saut à 2♦ n'est pas le sujet du visa.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V49-006",
      "choice": "2SA",
      "reason": "#364 confirme la première réponse 1♦. Ne pas déduire une cause unique pour 2SA, qui cumule force, forme et ordre descriptif.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V426-002",
      "choice": "1♠",
      "reason": "#364 confirme 14 HL, donc 1♦ avant 1♠. La revue B n'a pas livré d'hypothèse signée pour l'option ; maintien prudent sans réouverture.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V426-002",
      "choice": "2♦",
      "reason": "Le visa #364 porte sur l'ordre des couleurs et non sur la signification du saut à 2♦.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V426-002",
      "choice": "2SA",
      "reason": "Plusieurs écarts possibles : zone de force, forme et ordre de description ; aucune cause privilégiée n'est nécessaire.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V4-005-2",
      "choice": "Passe",
      "reason": "3♥ a un objectif préventif explicité ; le choix de passer reste un jugement tactique sans vulnérabilité adverse précisée.",
      "diagnosticStatus": "unknown"
    },
    {
      "id": "SEF-V4-006-2",
      "choice": "Passe",
      "reason": "Le singleton Roi et neuf atouts ne rendent pas le prolongement de barrage obligatoire en silence adverse.",
      "diagnosticStatus": "unknown"
    },
